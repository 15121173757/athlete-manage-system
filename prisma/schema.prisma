// ============================================================
// 运动员管理系统（AMS）Prisma Schema
// ============================================================
// 设计说明：
// - 所有业务表均预留 teamId 字段（V1 默认值），为未来多租户扩展做准备
// - 敏感数据（健康类）通过 recordedBy 字段追溯操作人，配合审计日志
// - HealthMetric.source 字段预留 'Polar' 枚举值，为设备接入做准备
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// 用户与认证
// ============================================================

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique           // 登录用户名
  passwordHash String                     // bcrypt 哈希
  name         String                     // 姓名
  role         String  @default("COACH")  // 角色
  isActive     Boolean  @default(true)    // 是否启用
  teamId       Int      @default(1)       // 团队 ID（V1 单团队，预留多租户）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 关联：作为教练制定的训练计划
  trainingPlansCreated  TrainingPlan[] @relation("CoachPlans")
  // 关联：作为录入人
  trainingRecordsRecorded TrainingRecord[] @relation("RecordedBy")
  attendanceRecorded      AttendanceRecord[] @relation("AttendanceRecordedBy")
  fitnessRecordsRecorded  FitnessRecord[]  @relation("FitnessRecordedBy")
  injuriesRecorded        Injury[]         @relation("InjuryRecordedBy")
  injuryHistories         InjuryHistory[]  @relation("InjuryHistoryOperator")
  healthMetricsRecorded   HealthMetric[]   @relation("HealthMetricRecordedBy")
  loadRecordsRecorded     LoadRecord[]     @relation("LoadRecordedBy")
  jumpAnalysisRecorded    JumpAnalysisRecord[] @relation("JumpAnalysisRecordedBy")
  // 审计日志
  auditLogs AuditLog[]
  // 关联：创建的体能测试计划
  fitnessPlansCreated FitnessTestPlan[] @relation("FitnessPlanCreator")
  // 关联：录入的体能测试成绩
  fitnessResultsRecorded FitnessTestResult[] @relation("FitnessResultRecordedBy")

  @@map("users")
}

// ============================================================
// 运动员档案
// ============================================================

model Athlete {
  id        Int           @id @default(autoincrement())
  name      String                              // 姓名
  gender    String                              // 性别
  birthDate DateTime                            // 出生日期
  height    Float?                              // 身高 (cm)
  weight    Float?                              // 体重 (kg)
  sport     String                              // 项目
  position  String?                             // 位置
  joinDate  DateTime                            // 入队日期
  photoUrl  String?                             // 照片 URL
  metadata  String        @default("{}")        // 扩展字段（可配置属性，JSON 字符串）
  teamId    Int           @default(1)           // 团队 ID（预留多租户）
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // 关联
  planAthletes      TrainingPlanAthlete[]
  trainingPlanItems TrainingPlanItem[]
  trainingRecords   TrainingRecord[]
  attendanceRecords AttendanceRecord[]
  personalBests     PersonalBest[]
  fitnessRecords    FitnessRecord[]
  injuries          Injury[]
  healthMetrics     HealthMetric[]
  loadRecords       LoadRecord[]
  jumpAnalysisRecords JumpAnalysisRecord[]
  fitnessPlanParticipants FitnessTestPlanParticipant[]
  fitnessTestResults      FitnessTestResult[]

  @@map("athletes")
}

// ============================================================
// 训练管理
// ============================================================

model Exercise {
  id             Int      @id @default(autoincrement())
  name           String   @unique                // 项目名称（如"深蹲"）
  category       String                          // 分类：力量/速度/耐力/柔韧
  unit           String                          // 计量单位：kg/次/秒
  description    String?                         // 动作描述
  difficulty     String?                         // 难度：初级/中级/高级
  targetMuscles  String?                         // 目标肌群（逗号分隔）
  equipment      String?                         // 所用器材（逗号分隔）
  demoImageUrl   String?                         // 示范图片链接
  demoVideoUrl   String?                         // 示范视频链接
  isFavorite     Boolean  @default(false)        // 是否收藏
  sortOrder      Int      @default(0)            // 排序权重
  isPBTrackable  Boolean  @default(true)         // 是否追踪 PB
  trackType      String   @default("MAX_WEIGHT") // 追踪类型（决定 PB 取值字段与更新方向）
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // 关联
  planItems       TrainingPlanItem[]
  records         TrainingRecord[]
  personalBests   PersonalBest[]

  @@index([category])
  @@index([isFavorite])
  @@map("exercises")
}

model TrainingPlan {
  id        Int        @id @default(autoincrement())
  coachId   Int                                  // 教练员 ID
  goal      String?                              // 训练目标
  startDate DateTime?                            // 执行开始日期（计划执行日）
  startTime String?                              // 执行开始时间（HH:mm）
  status    String @default("DRAFT")           // 状态
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  coach      User           @relation("CoachPlans", fields: [coachId], references: [id])
  items      TrainingPlanItem[]
  planAthletes TrainingPlanAthlete[]

  @@map("training_plans")
}

model TrainingPlanAthlete {
  id        Int       @id @default(autoincrement())
  planId    Int
  athleteId Int

  plan    TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  athlete Athlete      @relation(fields: [athleteId], references: [id])

  @@unique([planId, athleteId])
  @@map("training_plan_athletes")
}

model TrainingPlanItem {
  id          Int     @id @default(autoincrement())
  planId      Int                                  // 计划 ID
  athleteId   Int?                                 // 运动员 ID（为空表示全员共享配置，兼容历史计划数据）
  exerciseId  Int                                   // 项目 ID
  sets        Int                                   // 组数
  reps        Int                                   // 次数
  load        Float?                                // 负荷 (kg)
  restSeconds Int?                                  // 间歇时间（秒）
  duration    Int?                                  // 预计时长（分钟）
  tempo       String?                               // 节奏（自由文本，如 2-0-1-0：离心-停顿-向心-停顿秒数）
  sortOrder   Int     @default(0)                   // 排序
  notes       String?                               // 备注

  plan     TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercise Exercise     @relation(fields: [exerciseId], references: [id])
  athlete  Athlete?     @relation(fields: [athleteId], references: [id])

  @@index([planId, sortOrder])
  @@map("training_plan_items")
}

model TrainingRecord {
  id            Int      @id @default(autoincrement())
  athleteId     Int                                   // 运动员 ID
  planItemId    Int?                                  // 关联计划项（可选）
  exerciseId    Int                                   // 项目 ID
  actualSets    Int                                   // 实际组数
  actualReps    Int                                   // 实际次数
  actualLoad    Float?                                // 实际负荷 (kg)
  metricValue   Float?                                // 追踪类型核心量化值（时间/高度/距离等）
  trainingDate  DateTime                              // 训练日期
  rpe           Int?                                  // 主观疲劳度 (1-10)
  notes         String?                               // 备注
  recordedById  Int                                   // 录入人 ID
  createdAt     DateTime @default(now())

  athlete    Athlete  @relation(fields: [athleteId], references: [id])
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  recordedBy User     @relation("RecordedBy", fields: [recordedById], references: [id])

  @@index([athleteId, exerciseId, trainingDate])
  @@map("training_records")
}

model PersonalBest {
  id           Int      @id @default(autoincrement())
  athleteId    Int                                   // 运动员 ID
  exerciseId   Int                                   // 项目 ID
  value        Float                                 // 最好成绩值
  unit         String                                // 单位
  achievedDate DateTime                              // 达成日期
  recordId     Int?                                  // 关联训练记录 ID（手动录入的 PB 为 null）
  createdAt    DateTime @default(now())

  athlete  Athlete  @relation(fields: [athleteId], references: [id])
  exercise Exercise @relation(fields: [exerciseId], references: [id])

  @@unique([athleteId, exerciseId])  // 每个运动员每个项目只有一条 PB 纪录
  @@map("personal_bests")
}

// ============================================================
// 出勤记录（出勤表管理）
// ============================================================

model AttendanceRecord {
  id             Int      @id @default(autoincrement())
  attendanceDate DateTime                            // 出勤日期（YYYY-MM-DD，UTC 零点）
  athleteId      Int                                 // 运动员 ID
  status         String                              // 出勤状态：PRESENT/INJURED_ABSENT/PERSONAL_LEAVE/COMPETITION/TRAINING_CAMP/SUSPENDED
  rpe            Int?                                // 自觉劳累程度（1-10，可空；历史数据默认 null）
  durationMinutes Int?                               // 训练时长（分钟，非负整数，可空；历史数据默认 null）
  notes          String?                             // 备注
  recordedById   Int                                 // 录入人 ID
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  athlete    Athlete @relation(fields: [athleteId], references: [id])
  recordedBy User    @relation("AttendanceRecordedBy", fields: [recordedById], references: [id])

  @@unique([attendanceDate, athleteId])
  @@index([attendanceDate])
  @@index([athleteId, attendanceDate])
  @@map("attendance_records")
}

// ============================================================
// 体能测试
// ============================================================

model FitnessTest {
  id                Int           @id @default(autoincrement())
  name              String        @unique            // 测试名称（如"1RM 深蹲"）
  category          String                            // 分类：力量/爆发力/速度敏捷/供能系统
  unit              String                            // 单位
  direction         String @default("HIGHER_BETTER")
  warningThreshold  Float?                            // 预警阈值
  description       String?                           // 测试说明
  purpose           String?                           // 测试目的
  applicableGroup   String?                           // 适用人群
  equipment         String?                           // 所需器材清单（逗号分隔）
  demoVideoUrl      String?                           // 演示视频链接
  diagramUrl        String?                           // 动作图解链接
  standards         String?                           // 测试标准（常模）数组 JSON：[{normName, mean, stdDev}]
  referenceRange    String?                           // 参考数据范围
  precautions       String?                           // 测试注意事项
  resultType        String  @default("NUMERIC")       // 成绩类型：NUMERIC 数值 / GRADE 等级 / DESCRIPTIVE 描述
  gradeOptions      String?                           // 等级型成绩选项（JSON 数组，如 ["优秀","良好","及格"]）
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  records   FitnessRecord[]
  planItems FitnessTestPlanItem[]
  results   FitnessTestResult[]

  @@map("fitness_tests")
}

model FitnessRecord {
  id           Int      @id @default(autoincrement())
  athleteId    Int                                  // 运动员 ID
  testId       Int                                  // 测试项目 ID
  value        Float                                 // 测试值
  testDate     DateTime                              // 测试日期
  recordedById Int                                   // 录入人 ID
  createdAt    DateTime @default(now())

  athlete    Athlete     @relation(fields: [athleteId], references: [id])
  test       FitnessTest @relation(fields: [testId], references: [id])
  recordedBy User        @relation("FitnessRecordedBy", fields: [recordedById], references: [id])

  @@index([athleteId, testId, testDate])
  @@map("fitness_records")
}

// ============================================================
// 健康与伤病
// ============================================================

model Injury {
  id             Int           @id @default(autoincrement())
  athleteId      Int                                   // 运动员 ID
  injuryType     String                                // 伤病类型
  description    String                                // 描述
  bodyPart       String?                               // 受伤部位
  cause          String?                               // 受伤原因
  diagnosis      String?                               // 诊断结果
  treatment      String?                               // 治疗方案
  attachmentPath String?                               // 附件存储路径
  attachmentName String?                               // 附件原始文件名
  attachmentType String?                               // 附件 MIME 类型
  attachmentSize Int?                                  // 附件大小（字节）
  startDate      DateTime                              // 受伤日期
  endDate        DateTime?                             // 痊愈日期
  status         String  @default("INJURED")       // 状态
  recordedById   Int                                   // 录入人 ID（医研人员）
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  athlete     Athlete       @relation(fields: [athleteId], references: [id])
  recordedBy  User          @relation("InjuryRecordedBy", fields: [recordedById], references: [id])
  recoveryPlan RecoveryPlan?
  history     InjuryHistory[]

  @@index([athleteId, status])
  @@index([status, startDate])
  @@map("injuries")
}

model InjuryHistory {
  id        Int      @id @default(autoincrement())
  injuryId  Int                                   // 关联伤病 ID
  changedBy Int                                   // 操作人 ID
  changes   String                                // 变更内容（JSON：{ 字段: { before, after } }）
  note      String?                               // 变更备注
  createdAt DateTime @default(now())

  injury   Injury @relation(fields: [injuryId], references: [id], onDelete: Cascade)
  operator User   @relation("InjuryHistoryOperator", fields: [changedBy], references: [id])

  @@index([injuryId, createdAt])
  @@map("injury_histories")
}

model RecoveryPlan {
  id                Int            @id @default(autoincrement())
  injuryId          Int            @unique                    // 关联伤病 ID
  content           String                                    // 康复内容
  startDate         DateTime                                  // 开始日期
  targetReturnDate  DateTime                                  // 目标回归日期
  status            String @default("IN_PROGRESS")       // 状态
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  injury Injury @relation(fields: [injuryId], references: [id])

  @@map("recovery_plans")
}

model HealthMetric {
  id           Int                @id @default(autoincrement())
  athleteId    Int                                       // 运动员 ID
  metricType   String                          // 类型
  value        Float                                     // 值
  unit         String                                    // 单位
  recordedAt   DateTime                                  // 记录时间
  source       String @default("MANUAL")       // 来源
  recordedById Int?                                      // 录入人（人工时）
  createdAt    DateTime           @default(now())

  athlete    Athlete @relation(fields: [athleteId], references: [id])
  recordedBy User?   @relation("HealthMetricRecordedBy", fields: [recordedById], references: [id])

  @@index([athleteId, metricType, recordedAt])
  @@map("health_metrics")
}

// ============================================================
// 负荷监控（伤病与负荷监控模块）
// ============================================================

model LoadRecord {
  id              Int      @id @default(autoincrement())
  athleteId       Int                                   // 运动员 ID
  recordDate      DateTime                              // 训练日期
  rpe             Int                                   // 自觉劳累程度（1-10）
  durationMinutes Int                                   // 训练时长（分钟）
  trainingType    String?                               // 训练类型（力量/速度/耐力/柔韧/技巧/恢复）
  notes           String?                               // 备注
  recordedById    Int                                   // 录入人 ID
  createdAt       DateTime @default(now())

  athlete    Athlete @relation(fields: [athleteId], references: [id])
  recordedBy User    @relation("LoadRecordedBy", fields: [recordedById], references: [id])

  @@index([athleteId, recordDate])
  @@map("load_records")
}

// ============================================================
// 审计日志
// ============================================================

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int                                   // 操作用户 ID
  action     String                                // 动作（如 READ_HEALTH_DATA）
  targetType String                                // 目标类型（如 Injury）
  targetId   String?                               // 目标 ID
  detail     String    @default("{}")              // 详情（JSON 字符串）
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([targetType, createdAt])
  @@map("audit_logs")
}

// ============================================================
// 体能测试计划
// ============================================================

model FitnessTestPlan {
  id                Int                @id @default(autoincrement())
  name              String                                  // 计划名称
  testDate          DateTime                                // 测试日期
  startTime         String?                                 // 开始时间（HH:mm）
  estimatedDuration Int?                                    // 预计时长（分钟）
  location          String?                                 // 测试地点
  weather           String?                                 // 天气状况
  venueCondition    String?                                 // 场地条件描述
  status            String @default("DRAFT")       // 状态
  notes             String?                                 // 备注
  createdById       Int                                     // 创建人 ID
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  createdBy   User                     @relation("FitnessPlanCreator", fields: [createdById], references: [id])
  items       FitnessTestPlanItem[]
  participants FitnessTestPlanParticipant[]
  results     FitnessTestResult[]

  @@index([testDate])
  @@map("fitness_test_plans")
}

model FitnessTestPlanItem {
  id               Int     @id @default(autoincrement())
  planId           Int                                       // 计划 ID
  testId           Int                                       // 测试项目 ID
  sortOrder        Int     @default(0)                       // 排序
  groupName        String?                                   // 分组名称
  allocatedMinutes Int?                                      // 时间分配（分钟）
  equipmentReady   Boolean @default(false)                   // 器材准备状态

  plan FitnessTestPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  test FitnessTest     @relation(fields: [testId], references: [id])

  @@index([planId, sortOrder])
  @@map("fitness_test_plan_items")
}

model FitnessTestPlanParticipant {
  id        Int @id @default(autoincrement())
  planId    Int                                          // 计划 ID
  athleteId Int                                          // 运动员 ID

  plan    FitnessTestPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  athlete Athlete         @relation(fields: [athleteId], references: [id])

  @@unique([planId, athleteId])
  @@map("fitness_test_plan_participants")
}

// ============================================================
// 体能测试成绩（测试成绩录入）
// ============================================================

model FitnessTestResult {
  id           Int      @id @default(autoincrement())
  planId       Int                                     // 测试计划 ID
  athleteId    Int                                     // 运动员 ID
  testId       Int                                     // 测试项目 ID
  rawValue     String?                                 // 原始录入成绩文本（统一展示口径）
  value        Float?                                  // 数值型成绩（NUMERIC）
  gradeValue   String?                                 // 等级型成绩（GRADE）
  textValue    String?                                 // 描述型成绩（DESCRIPTIVE）
  recordedById Int                                     // 录入人 ID
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  plan    FitnessTestPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  athlete Athlete         @relation(fields: [athleteId], references: [id])
  test    FitnessTest     @relation(fields: [testId], references: [id])
  recordedBy User         @relation("FitnessResultRecordedBy", fields: [recordedById], references: [id])

  @@unique([planId, athleteId, testId])
  @@index([planId, testId])
  @@map("fitness_test_results")
}

// ============================================================
// 跳跃分析（视频跳跃生物力学分析工具）
// ============================================================

model JumpAnalysisRecord {
  id              Int      @id @default(autoincrement())
  athleteId       Int                                     // 运动员 ID
  testType        String                                  // 测试类型：CMJ / SJ / DJ / REPEAT_10_5
  testDate        DateTime                                // 测试日期（本地零点）
  videoName       String?                                 // 视频文件名（视频本体仅存本地，不入库）
  videoFps        Int?                                    // 视频帧率（标记精度依据）
  // 单跳指标（CMJ / SJ / DJ）
  flightTimeMs    Float?                                  // 飞行时间（ms）
  jumpHeightCm    Float?                                  // 跳跃高度（cm，h = g·t²/8）
  takeoffVelocity Float?                                  // 起跳速度（m/s，v = g·t/2）
  contactTimeMs   Float?                                  // 触地时间（ms，DJ / 10-5 使用）
  rsi             Float?                                  // 反应力量指数（= 高度(m) / 触地时间(s)）
  dropHeightCm    Int?                                    // 下落高度（cm，DJ 跳深使用）
  // 10-5 重复跳汇总
  jumpCount       Int?                                    // 跳跃次数
  avgHeightCm     Float?                                  // 平均高度（cm）
  bestHeightCm    Float?                                  // 最佳高度（cm）
  avgRsi          Float?                                  // 平均 RSI
  rsiCv           Float?                                  // RSI 变异系数（%）
  details         String    @default("[]")                // 逐跳明细（JSON 数组）
  notes           String?                                 // 备注
  recordedById    Int                                     // 录入人 ID
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  athlete    Athlete @relation(fields: [athleteId], references: [id])
  recordedBy User    @relation("JumpAnalysisRecordedBy", fields: [recordedById], references: [id])

  @@index([athleteId, testDate])
  @@map("jump_analysis_records")
}
