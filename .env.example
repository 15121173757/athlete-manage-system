# ============================================================
# 运动员管理系统（AMS）环境变量模板
# 复制本文件为 .env.local 并填写真实值
# ============================================================

# 数据库（PostgreSQL，内网部署）
# 示例：postgresql://用户名:密码@主机:端口/数据库名
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ams_db"

# 认证密钥（JWT 签名用，生产环境务必更换为随机长字符串）
# 生成命令：openssl rand -base64 32
AUTH_SECRET="change-this-to-a-random-secret-in-production"

# ------------------------------------------------------------
# LLM Provider 配置（多家可切换）
# ------------------------------------------------------------

# 当前启用的 Provider：zhipu | deepseek | qwen
MODEL_PROVIDER="zhipu"

# 智谱 GLM（https://open.bigmodel.cn/）
ZHIPU_API_KEY=""
ZHIPU_MODEL="glm-4-plus"

# DeepSeek（https://platform.deepseek.com/）
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"

# 通义千问 Qwen（https://dashscope.aliyun.com/）
QWEN_API_KEY=""
QWEN_MODEL="qwen-max"

# LLM 调用参数
# temperature：0-1，越低越确定；分析场景建议 0.3
LLM_TEMPERATURE="0.3"
# max_tokens：单次响应上限
LLM_MAX_TOKENS="4096"

# ------------------------------------------------------------
# 文件上传
# ------------------------------------------------------------
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE="5242880"

# ------------------------------------------------------------
# 应用
# ------------------------------------------------------------
APP_NAME="运动员管理系统"
APP_URL="http://localhost:3000"
